{
  "name": "track-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:environment": "node scripts/check-environment.mjs",
    "test:tooling": "node --test scripts/check-environment.test.mjs",
    "test:ops": "node --test ops/laptop/*.test.mjs ops/pc-jobs/*.test.mjs ops/glass/*.test.mjs",
    "test:ops:integration": "node scripts/test-ops-integration.mjs linux ops/local-minimal/*.test.mjs ops/pc-host/*.test.mjs ops/pc-host/backup-review/*.test.mjs ops/pc-host/db-review/*.test.mjs ops/pc-host/cloudflare/*.test.mjs ops/pc-backup/*.test.mjs ops/pc-retirement/*.test.mjs ops/pc-image-cleanup/*.test.mjs ops/pc-auth-sync/*.test.mjs ops/pc-rest-relay/*.test.mjs ops/review/*.test.mjs ops/review/cloudflare/*.test.mjs",
    "test:ops:windows": "node scripts/test-ops-integration.mjs win32",
    "test:ops:node": "npm run test:ops && npm run test:ops:integration",
    "test:ops:linux": "python3 -I -B scripts/test-linux-ops.py",
    "test:ops:db:cloud-fence": "python3 -I -B ops/local-minimal/cloud-source-freeze.test.py",
    "test:ops:db:final-fence": "python3 -I -B ops/local-minimal/final-freeze.test.py",
    "test:cloudflare": "node --test ops/pc-host/cloudflare/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@smithy/node-http-handler": "4.12.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.20.0",
    "next": "16.4.3",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
