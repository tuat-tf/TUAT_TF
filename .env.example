# Local development / PC runtime. Values stay empty; see ops/pc-host/environment.local.example.env for the shape.
PC_APP_RUNTIME=
NEXT_PUBLIC_PC_APP_RUNTIME=
PC_LOCAL_RUNTIME=
NEXT_PUBLIC_PC_LOCAL_RUNTIME=
PC_BACKEND_ENABLED=
NEXT_PUBLIC_PC_BACKEND=
APP_PUBLIC_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PC_LOCAL_AUTH_URL=
PC_LOCAL_REST_URL=

# Local image storage
IMAGE_STORAGE_DRIVER=local
LOCAL_IMAGE_STORAGE_ROOT=
LOCAL_IMAGE_SIGNING_KEY=
LOCAL_IMAGE_MAX_STORAGE_BYTES=
IMAGE_STORAGE_READ_ONLY=

# Web Push (server-only except the public key)
LOCAL_WEB_PUSH_ENABLED=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional admin-only Vercel usage integration. Never use NEXT_PUBLIC_ for a token.
VERCEL_MONITORING_TOKEN=
SERVICE_STATUS_VERCEL_TEAM_ID=

# Retired paths: still read by code that is kept until the deferred cleanup; leave empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_READ_ENABLED=
R2_WRITE_ENABLED=
R2_UPLOADS_PAUSED=
R2_MAX_STORAGE_BYTES=
NEXT_PUBLIC_IMAGE_DELIVERY_VERSION=
GOOGLE_DRIVE_CLIENT_SECRET=
SHEET_SYNC_SPREADSHEET_ID=
SHEET_SYNC_GAS_URL=
SHEET_SYNC_SECRET=
SHEET_SYNC_ENABLED=
SHEET_SYNC_CONCURRENCY=
SHEET_SYNC_PUSH_LIMIT=
SHEET_SYNC_CHUNK_SIZE=
